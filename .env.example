# Local run of synthwerk-llm outside compose (go run ./cmd/llm). Copy to .env.
SYNTHWERK_PLATFORM_ENV=local
SYNTHWERK_LLM_HTTP_ADDR=:8080
SYNTHWERK_LLM_DATABASE_URL=postgres://llm:CHANGE_ME@localhost:5432/synthwerk?sslmode=disable
SYNTHWERK_LLM_NATS_URL=nats://synthwerk:CHANGE_ME@localhost:4222
# ollama | openai_compat | fake (fake is refused in stg and prd)
SYNTHWERK_LLM_PROVIDER=ollama
SYNTHWERK_LLM_BASE_URL=http://localhost:11434/v1
SYNTHWERK_LLM_MODEL_ALIASES=default=qwen3.5:4b
# eu | non_eu. Default eu for ollama and fake; required for openai_compat.
SYNTHWERK_LLM_REGION=eu
# Fallback providers in order (#56). Empty: none. Per name: FALLBACK_<NAME>_PROVIDER,
# _BASE_URL, _API_KEY[_FILE], _REGION, _MODEL_ALIASES. A non_eu provider needs ALLOW_NON_EU=true.
SYNTHWERK_LLM_FALLBACKS=
# SYNTHWERK_LLM_FALLBACK_BACKUP_PROVIDER=openai_compat
# SYNTHWERK_LLM_FALLBACK_BACKUP_BASE_URL=https://llm.example.eu/v1
# SYNTHWERK_LLM_FALLBACK_BACKUP_REGION=eu
# SYNTHWERK_LLM_FALLBACK_BACKUP_MODEL_ALIASES=default=some-model
SYNTHWERK_LLM_ALLOW_NON_EU=false
# Tokens per UTC day per user and per org (0 = no limit). Config until entitlements (#31).
SYNTHWERK_LLM_QUOTA_USER_TOKENS=50000
SYNTHWERK_LLM_QUOTA_ORG_TOKENS=500000
SYNTHWERK_LLM_OIDC_ISSUER=http://auth.localhost:8080
SYNTHWERK_LLM_OIDC_AUDIENCE=synthwerk-api
# Empty: OIDC discovery on the issuer.
SYNTHWERK_LLM_JWKS_URL=
# Identity as llm reaches it, for the AI settings (/v1/ai-settings, #39). Empty: those routes answer 503.
SYNTHWERK_LLM_IDENTITY_URL=http://localhost:8080/identity
